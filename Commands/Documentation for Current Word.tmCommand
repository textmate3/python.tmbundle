<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>nop</string>
	<key>command</key>
	<string>#!/bin/bash
[[ -f "${TM_SUPPORT_PATH}/lib/bash_init.sh" ]] &amp;&amp; . "${TM_SUPPORT_PATH}/lib/bash_init.sh"

# Set up TM_FIRST_LINE with the first line of the script, which is how the
# helpers know whether the file names an interpreter of its own.
read first_line
0&lt;&amp;- # close stdin
export TM_FIRST_LINE="$first_line"

export PYTHONPATH="$TM_BUNDLE_SUPPORT/DocMate:$TM_SUPPORT_PATH/lib:$PYTHONPATH"

"${TM_PYTHON:-python3}" - &lt;&lt;'PYTHON'
import sys

import dialog
import docmate
import tm_helpers
import webpreview

docmate.launch_pydoc_server()

word = tm_helpers.current_word(r"[A-Za-z0-9_\.]*")


def redirect(url):
    print("&lt;meta http-equiv='Refresh' content='0;URL=%s'&gt;" % url)


def links(heading, entries, marker):
    print("&lt;h3&gt;%s&lt;/h3&gt;" % heading)
    print("&lt;ol style='list-style-type: %s;'&gt;" % ("lower-alpha" if marker == "a" else "decimal"))
    for index, (description, url) in enumerate(entries):
        key = chr(ord(marker) + index)
        print('\t&lt;li&gt;&lt;a href="%s" accesskey="%s"&gt;%s&lt;/a&gt;&lt;/li&gt;' % (url, key, description))
    print("&lt;/ol&gt;")


if not word:
    redirect(docmate.pydoc_url()[0])
    sys.exit()

library = docmate.library_docs(word)
local = docmate.local_docs(word)

if local and not library:
    redirect(local[0][1])
elif not local and not library:
    redirect(docmate.pydoc_url()[0])
else:
    print(webpreview.html_header("DocMate", "Python"))
    links("Python Library Documentation", library, "a")
    if local:
        links("Pydoc Documentation", local, "1")
    print(webpreview.html_footer())
PYTHON</string>
	<key>input</key>
	<string>document</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>keyEquivalent</key>
	<string>^h</string>
	<key>name</key>
	<string>Documentation for Current Word</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>html</string>
	<key>outputLocation</key>
	<string>newWindow</string>
	<key>scope</key>
	<string>source.python</string>
	<key>uuid</key>
	<string>443BBF21-6124-4486-BFCA-D18606465885</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
