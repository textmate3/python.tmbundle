<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>nop</string>
	<key>command</key>
	<string>#!/usr/bin/env python3
"""Expand to a call on the superclass of the method the caret is in.

Python 3 takes no arguments to super() inside a method body, so this writes
super().name(...) rather than super(Class, self).name(...), which is the
spelling the language documentation calls out as the one to prefer.
"""

import ast
import os
import sys

LINE = int(os.environ['TM_LINE_NUMBER'])
COLUMN = int(os.environ['TM_LINE_INDEX'])

lines = sys.stdin.readlines()

# The tab trigger took the word away and a hole does not parse, so put it back.
line = lines[LINE - 1] if LINE &lt;= len(lines) else ''
lines[LINE - 1:LINE] = [line[:COLUMN] + 'super' + line[COLUMN:]]


def enclosing_function(tree, line):
    """The innermost function whose body contains `line`, or None.

    Python records end_lineno on every node, so containment is a comparison
    rather than the guess this command used to make about having walked past
    the node it wanted.
    """
    found = None
    for node in ast.walk(tree):
        if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        if node.lineno &lt;= line &lt;= (node.end_lineno or node.lineno):
            if found is None or node.lineno &gt;= found.lineno:
                found = node
    return found


def arguments_of(function):
    """The function's parameters as snippet tab stops, without self."""
    if function is None:
        return []

    spec = function.args
    positional = list(spec.posonlyargs) + list(spec.args)
    parts = []

    for argument in positional[1:]:
        parts.append(argument.arg)
    if spec.vararg:
        parts.append('*' + spec.vararg.arg)
    for argument in spec.kwonlyargs:
        parts.append('%s=%s' % (argument.arg, argument.arg))
    if spec.kwarg:
        parts.append('**' + spec.kwarg.arg)

    return parts


try:
    tree = ast.parse(''.join(lines))
except SyntaxError:
    # An incomplete file is the normal case while typing, so say the useful
    # thing rather than nothing.
    print('super().${1:__init__}($2)')
    sys.exit()

function = enclosing_function(tree, LINE)
name = function.name if function else '__init__'

parts = arguments_of(function)
snippet_arguments = ', '.join('${%d:%s}' % (index + 2, part) for index, part in enumerate(parts))
print('super().${1:%s}(%s)' % (name, snippet_arguments))</string>
	<key>input</key>
	<string>document</string>
	<key>name</key>
	<string>super</string>
	<key>output</key>
	<string>insertAsSnippet</string>
	<key>scope</key>
	<string>source.python</string>
	<key>tabTrigger</key>
	<string>super</string>
	<key>uuid</key>
	<string>96FC8316-D3A1-4378-8C89-C431EE8AF013</string>
</dict>
</plist>
